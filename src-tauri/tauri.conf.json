{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrailTag",
  "version": "0.1.0",
  "identifier": "io.github.junyou1998.trailtag",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm fetch:exiftool && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TrailTag",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://tile.openstreetmap.org https://server.arcgisonline.com; connect-src ipc: http://ipc.localhost https://nominatim.openstreetmap.org; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/exiftool/": "exiftool/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "用 GPX 軌跡為照片補上地理資訊",
    "category": "Photography"
  }
}